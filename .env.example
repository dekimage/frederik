# Copy this file to ".env.local" (Next.js reads it locally) and fill real values.

# ─── Cloudinary (pick ONE authentication style) ───────────────────────────────
# Preferred: paste the URL from Dashboard → Account/Product environment credentials
CLOUDINARY_URL=cloudinary://YOUR_API_KEY:YOUR_API_SECRET@YOUR_CLOUD_NAME

# Alternative: omit CLOUDINARY_URL and use all three lines below instead
# CLOUDINARY_CLOUD_NAME=YOUR_CLOUD_NAME
# CLOUDINARY_API_KEY=YOUR_API_KEY
# CLOUDINARY_API_SECRET=YOUR_API_SECRET

# Optional upload folders (defaults: portfolio/cms-images and portfolio/products)
# CLOUDINARY_FOLDER_IMAGES=portfolio/cms-images
# CLOUDINARY_FOLDER_PRODUCTS=portfolio/products

# ─── Firebase Admin (required for Firestore / Storage) ─────────────────────────
FIREBASE_PROJECT_ID=photography-shop
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxx@photography-shop.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_STORAGE_BUCKET=photography-shop.appspot.com

# ─── Stripe (payments) ─────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLIC_KEY=pk_test_...

# ─── Site URL (used for Stripe redirect URLs and email links) ──────────────────
NEXT_PUBLIC_URL=http://localhost:3000

# ─── Resend (order confirmation emails after payment) ──────────────────────────
# Use a domain verified in Resend. A transactional subdomain is recommended.
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=orders@mail.wolfskin-photography.com
# Optional sender display name and reply-to inbox
RESEND_FROM_NAME=WOLFSKIN Photography
RESEND_REPLY_TO=your-real-inbox@example.com

# ─── Admin access ──────────────────────────────────────────────────────────────
# Email(s) allowed to sign in at /admin/login (comma-separated for multiple)
ADMIN_EMAIL=you@example.com
# Optional fallback secret for server-to-server admin API calls
# ADMIN_API_SECRET=long-random-string

# Optional: pin Firestore product used by payment integration tests
# PAYMENT_TEST_PRODUCT_ID=your_product_doc_id
# Reference market for PDP/cart list prices (default NL)
# NEXT_PUBLIC_PDP_PRICE_COUNTRY=NL
