# Copy this file to ".env.local" (Next.js reads it locally) and fill real values.

# ─── Cloudinary (pick ONE authentication style) ───────────────────────────────
# Preferred: paste the URL from Dashboard → Account/Product environment credentials
CLOUDINARY_URL=cloudinary://YOUR_API_KEY:YOUR_API_SECRET@YOUR_CLOUD_NAME

# Alternative: omit CLOUDINARY_URL and use all three lines below instead
# CLOUDINARY_CLOUD_NAME=YOUR_CLOUD_NAME
# CLOUDINARY_API_KEY=YOUR_API_KEY
# CLOUDINARY_API_SECRET=YOUR_API_SECRET

# Optional upload folders (defaults: portfolio/cms-images and portfolio/products)
# CLOUDINARY_FOLDER_IMAGES=portfolio/cms-images
# CLOUDINARY_FOLDER_PRODUCTS=portfolio/products

# ─── Firebase Admin (existing – required for Firestore / legacy Storage cleanup) ─
FIREBASE_PROJECT_ID=photography-shop
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxx@photography-shop.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_STORAGE_BUCKET=photography-shop.appspot.com
